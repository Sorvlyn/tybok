# Checkpoint paths for the regression checks (`tests/`).
#
# Copy this file to `tests/checkpoints.env` (same directory) and point each model at its
# checkpoint directory. The checks read these values through the `TYBOK_CHECKPOINT_<MODEL>`
# environment variables, so exporting them in the shell works just as well, and
# `--checkpoint PATH` / `--checkpoint MODEL=PATH` always wins over this file.
#
# A model whose variable is unset (or whose directory does not exist) is reported as SKIP,
# so the suite still runs on a machine that only has some of the checkpoints.

TYBOK_CHECKPOINT_SMOLVLA=/path/to/smolvla_checkpoint
TYBOK_CHECKPOINT_PI05=/path/to/pi05_checkpoint
TYBOK_CHECKPOINT_FASTWAM=/path/to/fastwam_checkpoint
